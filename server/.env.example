# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/beyond-the-bar
MONGODB_URI=

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin allowed to call the API with cookies
CLIENT_URL=http://localhost:3000

# Used by `npm run seed:admin` to create the first admin account
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
